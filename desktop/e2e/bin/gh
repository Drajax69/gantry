#!/bin/bash
# Offline stand-in for the gh CLI, backed by the fixture repo from e2e/setup.mjs.
ROOT="$(cd "$(dirname "$0")/.." && pwd)/.tmp"
case "$1 $2" in
  "repo view")
    if [[ "$3" == */missing ]]; then echo "GraphQL: Could not resolve to a Repository with the name '$3'." >&2; exit 1; fi
    if [[ "$*" == *defaultBranchRef* ]]; then echo main; else echo '{"name":"fixture"}'; fi ;;
  "repo clone") dir=$4; shift 5; exec git clone "$@" "file://$ROOT/remote.git" "$dir" ;;
  "pr view") # a test can set the state by writing it to $PR_LENS_HOME/pr-state
    state=$(cat "$PR_LENS_HOME/pr-state" 2>/dev/null || echo OPEN)
    echo '{"title":"Guard add against NaN","body":"Throws on NaN input.","author":{"login":"octo"},"state":"'"$state"'","isDraft":false,"baseRefName":"main","headRefName":"feature","headRepository":{"name":"fixture"},"headRepositoryOwner":{"login":"local"},"additions":4,"deletions":1}' ;;
  "search prs")
    if [[ "$*" == *review-requested* ]]; then
      echo '[{"number":1,"title":"Guard add against NaN","url":"https://github.com/local/fixture/pull/1","updatedAt":"2026-10-14T10:00:00Z","isDraft":false,"state":"open","repository":{"nameWithOwner":"local/fixture"}}]'
    else echo '[]'; fi ;;
  "auth git-credential") exit 0 ;;
  "api --paginate") # review comments, already shaped like our --jq output
    case "$3" in
      */pulls/1/comments)
        echo '{"id":11,"reply_to":null,"path":"src/util.py","line":2,"start_line":1,"original_line":2,"original_start_line":1,"side":"RIGHT","user":"hubot","avatar":null,"body":"Should this handle an empty **name**?","created_at":"2026-10-14T09:00:00Z","url":"https://github.com/local/fixture/pull/1#discussion_r11"}'
        echo '{"id":12,"reply_to":11,"path":"src/util.py","line":2,"start_line":1,"original_line":2,"original_start_line":1,"side":"RIGHT","user":"octo","avatar":null,"body":"Good point, will look.","created_at":"2026-10-14T09:30:00Z","url":"https://github.com/local/fixture/pull/1#discussion_r12"}'
        echo '{"id":13,"reply_to":null,"path":"src/math.ts","line":null,"start_line":null,"original_line":1,"original_start_line":null,"side":"RIGHT","user":"hubot","avatar":null,"body":"Old note on the signature.","created_at":"2026-10-13T09:00:00Z","url":"https://github.com/local/fixture/pull/1#discussion_r13"}' ;;
      */issues/1/comments)
        echo '{"id":21,"user":"octo","avatar":null,"body":"Ready for review!","created_at":"2026-10-14T08:00:00Z","url":"https://github.com/local/fixture/pull/1#issuecomment-21"}' ;;
      */pulls/1/reviews) ;;
      *) echo "Not Found" >&2; exit 1 ;;
    esac ;;
  "api repos/"*) # api repos/<owner>/<repo>/commits/<sha> --jq .sha
    git -C "$ROOT/remote.git" rev-parse --verify --quiet "${2##*/}^{commit}" || { echo "Not Found" >&2; exit 1; } ;;
  *) echo "gh stand-in: unsupported: $*" >&2; exit 1 ;;
esac
